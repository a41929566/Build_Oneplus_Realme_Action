# SUSFS环境守护 v6.3 配置（刷机后自动复制为 spoof.conf，之后升级不覆盖）

# 兼容旧版本的总开关；v6.3 WebUI 使用下面的逐项开关
global_spoof_enabled=0

# 单项开关
spoof_props_enabled=0
spoof_hwid_enabled=0
spoof_android_id=0
# 只在对应内核读取拦截成功后同步 MAC 属性，避免属性层先变而
# netlink/ioctl/HAL 仍返回真实值。1=启用安全约束，0=允许手动承担不一致风险。
identity_consistency_guard=1
spoof_serial=0
spoof_build=0
spoof_wifi_mac=0
spoof_bt_mac=0

# 伪装“检测方”A：对这些 app 隐藏环境/撤销应用列表（空格分隔，WebUI 可勾选）
# 王者/三角洲/和平精英/Maple
pkgmask_targets="com.tencent.tmgp.sgame com.tencent.tmgp.dfm com.tencent.tmgp.pubgmhd com.maple.detect"

# 被隐藏对象 B：对检测方 A 隐藏这些包的存在与数据目录（空格分隔）
pkgmask_hide_pkgs="bin.mt.plus bin.mt.plus.canary com.topjohnwu.magisk io.github.vvb2060.magisk"

# 需要在 /proc 层隐藏的进程 comm（默认同被隐藏包名，自动截断15字符，可手动追加）
pkgmask_hide_procs=""

# pkgmask 作用模式：deny=仅对 deny_uids(检测方) 隐藏（推荐，最不易误伤）
pkgmask_scope=deny

# 硬件ID作用域 UID（逗号分隔，留空=对所有进程伪装；想只对检测方就填其uid）
hwid_uids=""

# SUSFS 路径隐藏（由你的内核 susfs 执行，这里仅记录意图）
susfs_hide_paths="/data/adb /sbin/.magisk /system/bin/su"

# 守护循环间隔秒；操作完成后短时间使用 active 间隔
daemon_interval_idle=15
daemon_interval_active=1

# 硬件ID用户态回退：当内核无 hwid_spoof 时，可选用 bind mount 回退层
# 在用户态实现 SoC serial / UFS CID / WiFi MAC 伪装（全局生效，1=开 0=关）
hwid_userspace_fallback=0

# /proc/cpuinfo 用户态回退（有副作用：会冻结 CPU 信息为开机时快照，0=关 1=开）
hwid_userspace_cpuinfo=0

# 日志
log_level=3
log_max_kb=512
