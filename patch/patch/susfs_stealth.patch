From: SUSFS Stealth Patch
Subject: [PATCH] SUSFS stealth: hide detectable strings and thread names

Hide SUSFS-specific strings that detection tools (e.g. Maple) probe:
- Rename kernel thread susfs_sdcard_monitor -> ksdcardd
- Change log prefix "susfs:" -> "fs:"
- Remove "susfs is initialized" boot banner
- Neutralize SUSFS_VERSION string
---
 fs/susfs.c          | 10 +++++-----
 include/linux/susfs.h | 2 +-
 2 files changed, 6 insertions(+), 6 deletions(-)

diff --git a/fs/susfs.c b/fs/susfs.c
index 1234567..abcdefg 100644
--- a/fs/susfs.c
+++ b/fs/susfs.c
@@ -33,8 +33,8 @@ DEFINE_STATIC_KEY_TRUE(susfs_is_log_enabled);
 #ifdef CONFIG_KSU_SUSFS_ENABLE_LOG
 DEFINE_STATIC_KEY_TRUE(susfs_is_log_enabled);
-#define SUSFS_LOGI(fmt, ...) if (static_branch_likely(&susfs_is_log_enabled)) pr_info("susfs:[%u][%d][%s] " fmt, current_uid().val, current->pid, __func__, ##__VA_ARGS__)
-#define SUSFS_LOGE(fmt, ...) if (static_branch_likely(&susfs_is_log_enabled)) pr_err("susfs:[%u][%d][%s]" fmt, current_uid().val, current->pid, __func__, ##__VA_ARGS__)
+#define SUSFS_LOGI(fmt, ...) if (static_branch_likely(&susfs_is_log_enabled)) pr_info("fs:[%u][%d][%s] " fmt, current_uid().val, current->pid, __func__, ##__VA_ARGS__)
+#define SUSFS_LOGE(fmt, ...) if (static_branch_likely(&susfs_is_log_enabled)) pr_err("fs:[%u][%d][%s]" fmt, current_uid().val, current->pid, __func__, ##__VA_ARGS__)
 #else
 #define SUSFS_LOGI(fmt, ...) 
 #define SUSFS_LOGE(fmt, ...) 
@@ -1437,9 +1437,9 @@ static int __init susfs_init(void)
 	}
 
 	/* sdcard monitor */
-	if (IS_ERR(kthread_run(susfs_sdcard_monitor_fn, NULL, "susfs_sdcard_monitor"))) {
-		SUSFS_LOGE("failed to create thread susfs_sdcard_monitor\n");
+	if (IS_ERR(kthread_run(susfs_sdcard_monitor_fn, NULL, "ksdcardd"))) {
+		SUSFS_LOGE("failed to create thread ksdcardd\n");
 		return -ENOMEM;
 	}
 
-	SUSFS_LOGI("susfs is initialized! version: " SUSFS_VERSION " \n");
+	SUSFS_LOGI("fs stealth initialized\n");
 	return 0;
 }
diff --git a/include/linux/susfs.h b/include/linux/susfs.h
index 7654321..gfedcba 100644
--- a/include/linux/susfs.h
+++ b/include/linux/susfs.h
@@ -9,7 +9,7 @@
 #ifndef __LINUX_SUSFS_H
 #define __LINUX_SUSFS_H
 
-#define SUSFS_VERSION "v2.3.0"
+#define SUSFS_VERSION "0"
 
 #define SUSFS_MAX_VERSION_BUFSIZE 32
 
-- 
2.34.1
