六、ksys_getdents64()：
=====================================================================

6a. 结构体初始化加 .dir = NULL（.previous = NULL, 之后）：

	struct getdents_callback64 buf = {
		.ctx.actor = filldir64,
		.count = count,
		.previous = NULL,
+		.dir = NULL,
	};

6b. fdget_pos 成功、iterate_dir 调用之前加一行赋值：

	f = fdget_pos(fd);
	if (!f.file)
		return -EBADF;

+	buf.dir = file_inode(f.file);	/* pkgmask v3.2 */
	error = iterate_dir(f.file, &buf.ctx);

=====================================================================
七、ksys_getdents()（compat，32 位 readdir）同样处理：
=====================================================================

7a. 结构体初始化加 .dir = NULL：

	struct getdents_callback buf = {
		.ctx.actor = filldir,
		.count = count,
		.previous = NULL,
+		.dir = NULL,
	};

7b. iterate_dir 调用之前加一行赋值：

+	buf.dir = file_inode(f.file);	/* pkgmask v3.2 */
	error = iterate_dir(f.file, &buf.ctx);

